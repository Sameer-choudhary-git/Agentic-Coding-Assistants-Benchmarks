{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acb.local/schemas/task.schema.json",
  "title": "Benchmark task metadata (task.json)",
  "type": "object",
  "required": ["id", "title", "category", "difficulty", "difficulty_rationale", "version", "test_version", "kind", "summary",
               "required_behavior", "acceptance_criteria", "acceptance_tests", "scope", "time_limit_minutes", "test_timeout_seconds"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^(BF|FI|SR|RF|TW|RR)-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 5 },
    "category": { "enum": ["bug_fixing", "feature_implementation", "security_remediation", "refactoring", "test_writing", "repository_reasoning"] },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "difficulty_rationale": { "type": "string", "minLength": 20 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "test_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kind": { "enum": ["standard", "test_writing"] },
    "summary": { "type": "string", "minLength": 10 },
    "required_behavior": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "required": ["allowed_paths", "protected_paths"],
      "additionalProperties": false,
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "protected_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "time_limit_minutes": { "type": "integer", "minimum": 5, "maximum": 240 },
    "test_timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 1800 },
    "test_writing": {
      "type": "object",
      "required": ["target_module", "test_paths", "min_tests", "min_line_coverage", "min_mutation_score"],
      "additionalProperties": false,
      "properties": {
        "target_module": { "type": "string" },
        "test_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "min_tests": { "type": "integer", "minimum": 1 },
        "min_line_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_mutation_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "if": { "properties": { "kind": { "const": "test_writing" } } },
  "then": { "required": ["test_writing"] }
}
