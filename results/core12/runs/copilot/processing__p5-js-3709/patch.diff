diff --git a/src/webgl/p5.RendererGL.js b/src/webgl/p5.RendererGL.js
index fa87490c1..b42f903dd 100755
--- a/src/webgl/p5.RendererGL.js
+++ b/src/webgl/p5.RendererGL.js
@@ -1088,6 +1088,13 @@ p5.RendererGL.prototype._setFillUniforms = function(fillShader) {
   // TODO: optimize
   fillShader.setUniform('uMaterialColor', this.curFillColor);
   fillShader.setUniform('isTexture', !!this._tex);
+  var tint = this._tint || [255, 255, 255, 255];
+  fillShader.setUniform('uTint', [
+    tint[0] / 255,
+    tint[1] / 255,
+    tint[2] / 255,
+    tint[3] / 255
+  ]);
   if (this._tex) {
     fillShader.setUniform('uSampler', this._tex);
   }
