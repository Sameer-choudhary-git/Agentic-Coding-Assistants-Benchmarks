# Copy to .env (npm run setup does this) and adjust. Never commit .env.
# No API keys are needed by the platform itself.

# --- API server ---
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# --- Identity recorded on every run (used when merging team members' data) ---
ACB_OPERATOR=your-name
# ACB_MACHINE_ID defaults to the computer's host name
# ACB_MACHINE_ID=laptop-1

# --- Evaluation ---
# docker: sandboxed (no network, non-root, resource limits). Recommended for the official study.
#         Build the image once with: npm run docker:evaluator
# local:  runs hidden tests as a subprocess on this machine WITHOUT isolation. Use only when Docker
#         is unavailable, and use the same mode for every run in an experiment.
ACB_EVAL_MODE=docker
ACB_EVAL_CONCURRENCY=1
ACB_EVALUATOR_TIMEOUT_SECONDS=1800
# ACB_DOCKER_IMAGE=acb-evaluator:1.0
# ACB_DOCKER_MEMORY=1g
# ACB_DOCKER_CPUS=1

# Python interpreter for the evaluator (defaults to .venv if present)
# ACB_PYTHON=.venv/Scripts/python.exe

# Semgrep: install it, point to it, or run it from Docker
# ACB_SEMGREP_BIN=semgrep
# ACB_SEMGREP_DOCKER=1
# ACB_SEMGREP_EXTRA_CONFIGS=

# --- Storage (defaults shown) ---
# ACB_DB_PATH=./data/acb.sqlite
# ACB_ARTIFACT_ROOT=./artifacts
# Workspaces MUST be outside the repository so assistants cannot read hidden tests.
# ACB_WORKSPACE_ROOT=~/acb-workspaces

# --- Assistant automation (off by default; see docs/assistant-integrations.md) ---
ACB_ENABLE_AUTOMATION=0
# Optional command overrides, as JSON arrays. Placeholders: {prompt}, {prompt_file}, {workspace}
# ACB_CLAUDE_CODE_CMD=["claude","-p","{prompt}","--permission-mode","acceptEdits","--output-format","json"]
# ACB_CODEX_CMD=["codex","exec","--sandbox","workspace-write","--skip-git-repo-check","{prompt}"]
# ACB_COPILOT_CMD=["copilot","-p","{prompt}","--allow-all-tools","-s"]
# ACB_CURSOR_CMD=["cursor-agent","-p","--force","--output-format","text","{prompt}"]
# Credentials for automated runs are read from the vendors' own variables or login files
# (ANTHROPIC_API_KEY, OPENAI_API_KEY / CODEX_API_KEY, GH_TOKEN / COPILOT_GITHUB_TOKEN, CURSOR_API_KEY).

# --- Golden benchmark ---
# SWE-bench Pro tasks are scored with Pro's per-task test scripts:
#   git clone https://github.com/scaleapi/SWE-bench_Pro-os  then point this at its run_scripts folder
# ACB_SWEBENCH_PRO_SCRIPTS=/home/you/SWE-bench_Pro-os/run_scripts
# Optional: another golden task file (default golden/dataset/app_tasks.json)
# ACB_GOLDEN_APP_FILE=
