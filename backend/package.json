{
  "name": "@acb/backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API and experiment orchestration for the Agentic Coding Assistants benchmark",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch --import tsx src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 test/*.test.ts",
    "export": "node --disable-warning=ExperimentalWarning --import tsx src/cli/export.ts",
    "import-bundle": "node --disable-warning=ExperimentalWarning --import tsx src/cli/importBundle.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.9.0 || ^6.0.0"
  }
}
